a/**
 * Étape 1 — Une ville : des données (attributs) et un comportement (méthode).
 *
 * Essayez : compilez, puis clic droit sur la classe Monde → void main(String[] args).
 */
public class Ville {
    private String nomVille;
    private int nbHabitants;

    // Constructeur : même nom que la classe, aucun type de retour (pas même void).
    public Ville(String nomVille, int nbHabitants) {
        this.nomVille = nomVille;          // this.nomVille = l'attribut de l'objet ; nomVille = le paramètre
        this.nbHabitants = nbHabitants;
    }

    // Méthode d'instance : elle s'appelle sur un objet précis (tunis.decrisToi()).
    public void decrisToi() {
        System.out.println(nomVille + " : " + nbHabitants + " habitants");
    }
}

